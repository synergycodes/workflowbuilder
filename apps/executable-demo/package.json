{
  "name": "@workflow-builder/executable-demo",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently 'pnpm typecheck:watch' 'vite'",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch --pretty",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.7",
    "@workflow-builder/types": "workspace:*",
    "@workflowbuilder/ui": "workspace:*",
    "@xyflow/react": "catalog:",
    "clsx": "^2.1.1",
    "immer": "^10.1.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@vitejs/plugin-react": "^4.3.4",
    "@workflowbuilder/sdk": "workspace:*",
    "eslint-plugin-react": "7.37.2",
    "eslint-plugin-react-hooks": "5.1.0-rc.1",
    "vite": "^6.0.7",
    "vitest": "^3.0.4"
  }
}
