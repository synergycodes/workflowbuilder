---
// Every first-party type the UI Props tables mention, generated from source into ui-api.json.
import data from '../../generated/ui-api.json';
import PropertyList, { type PropertyRow } from './property-list.astro';
import TypeCode, { type TypeReference } from './type-code.astro';

interface TypeEntry {
  name: string;
  anchor: string;
  description: string;
  shape: string | null;
  shapeReferences: TypeReference[];
  properties: PropertyRow[];
}

const types = data.types as TypeEntry[];
---

{
  types.map((entry) => (
    <section class="type">
      <h2 id={entry.anchor}>
        <code>{entry.name}</code>
      </h2>
      {entry.description && <p>{entry.description.replaceAll('\n', ' ')}</p>}
      {entry.shape ? (
        <p class="shape">
          <TypeCode type={entry.shape} references={entry.shapeReferences} />
        </p>
      ) : (
        <PropertyList props={entry.properties} />
      )}
    </section>
  ))
}

<style>
  .type {
    margin-top: 2.5rem;
  }
  .type h2 code {
    background: none;
    padding: 0;
  }
  .shape :global(code) {
    white-space: pre-wrap;
    word-break: break-word;
  }
</style>
