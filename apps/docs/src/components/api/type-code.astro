---
// A type expression whose first-party type names link to their page in the UI API Reference.
export interface TypeReference {
  text: string;
  pagePath: string;
}

interface Props {
  type: string;
  references?: TypeReference[];
}

const { type, references = [] } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pagePaths = new Map(references.map((reference) => [reference.text, reference.pagePath]));
const names = [...pagePaths.keys()].map((name) => name.replaceAll(/[$.]/g, String.raw`\$&`));
const pattern = names.length > 0 ? new RegExp(String.raw`(?<![\w$.])(${names.join('|')})(?![\w$])`) : null;
const segments = pattern ? type.split(pattern) : [type];
---

<code
  >{
    segments.map((segment, index) =>
      index % 2 === 1 ? <a href={`${base}/ui-api/${pagePaths.get(segment)}/`}>{segment}</a> : segment,
    )
  }</code
>
