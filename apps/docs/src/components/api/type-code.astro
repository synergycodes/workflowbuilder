---
// A type expression whose first-party type names link to their entry on the UI Types page.
export interface TypeReference {
  text: string;
  anchor: string;
}

interface Props {
  type: string;
  references?: TypeReference[];
}

const { type, references = [] } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const anchors = new Map(references.map((reference) => [reference.text, reference.anchor]));
const names = [...anchors.keys()].map((name) => name.replaceAll(/[$.]/g, String.raw`\$&`));
const pattern = names.length > 0 ? new RegExp(String.raw`(?<![\w$.])(${names.join('|')})(?![\w$])`) : null;
const segments = pattern ? type.split(pattern) : [type];
---

<code
  >{
    segments.map((segment, index) =>
      index % 2 === 1 ? <a href={`${base}/ui-library/types/#${anchors.get(segment)}`}>{segment}</a> : segment,
    )
  }</code
>
