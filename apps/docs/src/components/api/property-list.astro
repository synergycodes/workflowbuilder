---
// Name / type / default / description rows shared by the component Props tables and the UI Types page.
import TypeCode from './type-code.astro';

export interface PropertyRow {
  name: string;
  type: string;
  references: string[];
  required: boolean;
  default: string | null;
  description: string;
}

interface Props {
  props: PropertyRow[];
}

const { props } = Astro.props;
---

<dl class="props">
  {
    props.map((property) => (
      <div class="prop">
        <div class="prop-head">
          <code class="prop-name">{property.name}</code>
          {property.required && <span class="chip">required</span>}
        </div>
        <div class="meta">
          <span class="meta-label">Type</span>
          <TypeCode type={property.type} references={property.references} />
        </div>
        {property.default && (
          <div class="meta">
            <span class="meta-label">Default</span>
            <code>{property.default}</code>
          </div>
        )}
        {property.description && <p class="prop-desc">{property.description.replaceAll('\n', ' ')}</p>}
      </div>
    ))
  }
</dl>

<style>
  .props {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    margin-top: 1rem;
  }
  .prop {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .prop-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .prop-name {
    font-size: 1rem;
    font-weight: 600;
    background: none;
    padding: 0;
  }
  .chip {
    font-size: 0.6875rem;
    line-height: 1;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.25rem 0.5rem;
    border-radius: 999px;
    background: var(--sl-color-accent-low);
    color: var(--sl-color-accent-high);
  }
  .meta {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }
  .meta-label {
    min-width: 3.5rem;
    color: var(--sl-color-gray-3);
    font-size: 0.8125rem;
  }
  .meta :global(code) {
    font-size: 0.8125rem;
    white-space: pre-wrap;
    word-break: break-word;
  }
  .prop-desc {
    margin: 0.35rem 0 0;
    color: var(--sl-color-gray-2);
  }
</style>
