# Copy to .env next to docker-compose.yml. Every setting has a keyless local
# default; OpenRouter is needed only when a workflow reaches an AI Agent node.

# --- optional AI -------------------------------------------------------------

# Server-side only; never reaches the image build or browser. Leave empty to run
# non-AI workflows. An AI Agent then fails only that node with
# `ai_provider_not_configured`; no fake response is generated.
OPENROUTER_API_KEY=
AI_MODEL=mistralai/mistral-small-3.2-24b-instruct

# --- abuse gate (per-IP, execute route) -------------------------------------

RATE_LIMIT_EXECUTE_PER_MINUTE=10
RATE_LIMIT_EXECUTE_PER_DAY=50

# --- loopback-only host ports -----------------------------------------------

WEB_BIND=127.0.0.1
WEB_PORT=4200
TEMPORAL_BIND=127.0.0.1
TEMPORAL_PORT=7233
TEMPORAL_UI_BIND=127.0.0.1
TEMPORAL_UI_PORT=8233

# --- databases (internal Compose network only) ------------------------------

# Change these for non-ephemeral deployments. Keep values URL-safe because the
# application password is interpolated directly into a PostgreSQL connection URI.
APP_DB_PASSWORD=wb
TEMPORAL_DB_PASSWORD=temporal
