{
  "name": "@workflow-builder/mcp-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "wb-docs": "./dist/index.js"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm clean && tsc -p tsconfig.build.json && tsx scripts/generate-typedoc.ts",
    "typedoc": "tsx scripts/generate-typedoc.ts",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "smoke": "tsx scripts/smoke.ts",
    "fixtures:update": "tsx scripts/update-fixtures.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "github-slugger": "^2.0.0",
    "mdast-util-to-string": "^4.0.0",
    "minisearch": "^7.2.0",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "yaml": "^2.8.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.12.0",
    "tsx": "^4.19.3",
    "typedoc": "^0.28.9",
    "typescript": "~5.6.3",
    "vitest": "^3.0.4"
  }
}
